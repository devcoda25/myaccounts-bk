# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/myaccounts?schema=public"

# Auth Keys (Generated by KeyManager)
# No need to set these manually if using KeyManager auto-generation, 
# but for production you might mount them.

# Cookies
COOKIE_SECRET=super-secret-cookie-key

# Notifications - SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM_NUMBER=+1234567890

# Notifications - WhatsApp (Meta/WABA)
WABA_ACCESS_TOKEN=your_waba_access_token
WABA_PHONE_NUMBER_ID=your_waba_phone_number_id

# Notifications - Email (SendGrid - Primary)
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=noreply@evzone.com
MAIL_FROM_NAME=EVzone

# Provider Routing (Optional)
# PROVIDER_PRIMARY=sendgrid  # Default: sendgrid
# PROVIDER_FAILOVER_1=apiGlobal  # Default: apiGlobal
# PROVIDER_FAILOVER_CN=apiCN  # Default: apiCN

# Notifications - Email Fallback (EmailJS)
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_ACCESS_TOKEN=your_access_token


# ===============================================================
# Social Auth
# ===============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=your_apple_client_id


# ===============================================================
# Security / Auth
# ===============================================================
OIDC_ISSUER=http://localhost:3000
OIDC_AUDIENCE=myaccounts-client
OIDC_JWKS_URI=http://localhost:3000/api/v1/auth/jwks
OIDC_CACHE_TTL=600

# ===============================================================
# Edge Guards (Middleware)
# ===============================================================
ENFORCE_IP_ALLOWLIST=false
ALLOWED_IPS=127.0.0.1
ENFORCE_API_KEY=false
VALID_API_KEYS=your-secret-api-key


# ===============================================================
# Redis
# ===============================================================
REDIS_URL=redis://localhost:6379

# ===============================================================
# Frontend / CORS
# ===============================================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ===============================================================
# MFA / Encryption (required for MFA service)
# ===============================================================
# 32-byte key (example only). Generate a strong random value and keep it secret.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ===============================================================
# Object Storage (required)
# ===============================================================
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# ===============================================================
# Kafka (required)
# ===============================================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=myaccounts-service
KAFKA_GROUP_ID=myaccounts-consumer-group
KAFKA_SSL=false
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# ===============================================================
# Observability
# ===============================================================
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true
LOG_LEVEL=info

OTEL_SERVICE_NAME=myaccounts
# Collector base URL; traces go to /v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to debug for OTel diagnostics (very noisy)
OTEL_DIAGNOSTIC_LOG_LEVEL=error
